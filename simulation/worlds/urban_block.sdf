<?xml version="1.0" encoding="UTF-8"?>
<!--
  Small, self-contained urban flight block for the SpectrumClaw UAV module.
  It intentionally uses only SDF primitive geometry so an offline 3090 server
  never needs Gazebo Fuel while loading the scenario.
-->
<sdf version="1.9">
  <world name="urban_block">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.32 0.36 0.42 1</ambient>
      <background>0.42 0.58 0.72 1</background>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.25 0.45 -0.82</direction>
      <diffuse>1 0.96 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material><ambient>0.19 0.29 0.22 1</ambient><diffuse>0.22 0.37 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Two raised visual road surfaces; ground remains the collision plane. -->
    <model name="east_west_road"><static>true</static><pose>0 0 0.025 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>100 7 0.05</size></box></geometry><material><ambient>0.08 0.1 0.13 1</ambient><diffuse>0.12 0.15 0.18 1</diffuse></material></visual></link></model>
    <model name="north_south_road"><static>true</static><pose>0 0 0.03 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>7 100 0.06</size></box></geometry><material><ambient>0.08 0.1 0.13 1</ambient><diffuse>0.12 0.15 0.18 1</diffuse></material></visual></link></model>

    <!-- Keep a 10m x 10m open take-off square centred at the PX4 spawn. -->
    <model name="office_east">
      <static>true</static><pose>13 12 9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 10 18</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>10 10 18</size></box></geometry><material><ambient>0.26 0.32 0.38 1</ambient><diffuse>0.36 0.47 0.56 1</diffuse><specular>0.48 0.55 0.62 1</specular></material></visual>
        <visual name="roof"><pose>0 0 9.2 0 0 0</pose><geometry><box><size>7.5 7.5 0.45</size></box></geometry><material><ambient>0.12 0.16 0.2 1</ambient><diffuse>0.17 0.22 0.27 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tower_northwest">
      <static>true</static><pose>-13 14 11 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9 8 22</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>9 8 22</size></box></geometry><material><ambient>0.35 0.29 0.3 1</ambient><diffuse>0.56 0.4 0.42 1</diffuse><specular>0.35 0.28 0.3 1</specular></material></visual>
        <visual name="roof"><pose>0 0 11.25 0 0 0</pose><geometry><box><size>5.5 5.5 0.5</size></box></geometry><material><ambient>0.17 0.12 0.13 1</ambient><diffuse>0.24 0.17 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="residential_west">
      <static>true</static><pose>-16 -11 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 15</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>12 10 15</size></box></geometry><material><ambient>0.38 0.31 0.2 1</ambient><diffuse>0.62 0.49 0.3 1</diffuse><specular>0.22 0.17 0.1 1</specular></material></visual>
        <visual name="roof"><pose>0 0 7.75 0 0 0</pose><geometry><box><size>8.5 6.5 0.5</size></box></geometry><material><ambient>0.19 0.15 0.09 1</ambient><diffuse>0.25 0.2 0.13 1</diffuse></material></visual>
      </link>
    </model>
    <model name="warehouse_southeast">
      <static>true</static><pose>14 -14 5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 8 10</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>16 8 10</size></box></geometry><material><ambient>0.21 0.29 0.27 1</ambient><diffuse>0.31 0.45 0.4 1</diffuse><specular>0.2 0.28 0.25 1</specular></material></visual>
        <visual name="roof"><pose>0 0 5.25 0 0 0</pose><geometry><box><size>13 5.5 0.5</size></box></geometry><material><ambient>0.1 0.15 0.14 1</ambient><diffuse>0.15 0.22 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="library_north">
      <static>true</static><pose>0 25 5.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18 7 11</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>18 7 11</size></box></geometry><material><ambient>0.25 0.25 0.35 1</ambient><diffuse>0.38 0.39 0.59 1</diffuse><specular>0.25 0.25 0.38 1</specular></material></visual>
        <visual name="roof"><pose>0 0 5.75 0 0 0</pose><geometry><box><size>14 4 0.5</size></box></geometry><material><ambient>0.12 0.12 0.19 1</ambient><diffuse>0.18 0.18 0.29 1</diffuse></material></visual>
      </link>
    </model>
    <model name="clinic_west">
      <static>true</static><pose>-27 7 6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 10 12</size></box></geometry></collision>
        <visual name="facade"><geometry><box><size>10 10 12</size></box></geometry><material><ambient>0.3 0.35 0.32 1</ambient><diffuse>0.45 0.58 0.52 1</diffuse><specular>0.28 0.34 0.3 1</specular></material></visual>
        <visual name="roof"><pose>0 0 6.25 0 0 0</pose><geometry><box><size>6.5 6.5 0.5</size></box></geometry><material><ambient>0.14 0.18 0.16 1</ambient><diffuse>0.2 0.25 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Sparse trees make the lower-altitude LiDAR and side cameras useful. -->
    <model name="tree_a"><static>true</static><pose>8 9 0 0 0 0</pose><link name="link"><collision name="trunk_collision"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry></collision><visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry><material><diffuse>0.22 0.12 0.05 1</diffuse></material></visual><visual name="foliage"><pose>0 0 5 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.06 0.25 0.1 1</ambient><diffuse>0.1 0.43 0.17 1</diffuse></material></visual></link></model>
    <model name="tree_b"><static>true</static><pose>-8 10 0 0 0 0</pose><link name="link"><collision name="trunk_collision"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry></collision><visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry><material><diffuse>0.22 0.12 0.05 1</diffuse></material></visual><visual name="foliage"><pose>0 0 5 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.06 0.25 0.1 1</ambient><diffuse>0.1 0.43 0.17 1</diffuse></material></visual></link></model>
    <model name="tree_c"><static>true</static><pose>-9 -8 0 0 0 0</pose><link name="link"><collision name="trunk_collision"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry></collision><visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry><material><diffuse>0.22 0.12 0.05 1</diffuse></material></visual><visual name="foliage"><pose>0 0 5 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.06 0.25 0.1 1</ambient><diffuse>0.1 0.43 0.17 1</diffuse></material></visual></link></model>
    <model name="tree_d"><static>true</static><pose>9 -8 0 0 0 0</pose><link name="link"><collision name="trunk_collision"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry></collision><visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>4</length></cylinder></geometry><material><diffuse>0.22 0.12 0.05 1</diffuse></material></visual><visual name="foliage"><pose>0 0 5 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.06 0.25 0.1 1</ambient><diffuse>0.1 0.43 0.17 1</diffuse></material></visual></link></model>
  </world>
</sdf>
